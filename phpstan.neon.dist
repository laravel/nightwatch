parameters:
  paths:
    - src
  level: max
  ignoreErrors:
    -
      identifier: "nullCoalesce.offset"
      path: src/Ingest.php
      count: 1
      reportUnmatched: false
    # Laravel AI package is optional and unpublished - ignore all related errors
    -
      message: '#Laravel\\Ai\\#'
      reportUnmatched: false
    -
      identifier: 'property.nonObject'
      path: src/Sensors/AiEventSensor.php
      reportUnmatched: false
